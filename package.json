{
  "name": "blog-api",
  "version": "0.0.1",
  "description": "An API for a blog platform built with NestJS and Prisma.",
  "author": "Hagay Ashkenazi",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "postinstall": "prisma generate",
    "start": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "prestart:prod": "prisma migrate deploy && node tools/generate-types.ts",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "eslint .",
    "lint:report": "eslint --output-file eslint_report.json --format json .",
    "premigrate": "node --require dotenv/config tools/transfer-db-connection.ts",
    "migrate": "prisma migrate dev",
    "create-migration": "prisma migrate dev --create-only",
    "spellcheck": "cspell \"src/**\" --quiet"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.2.0",
    "@prisma/client": "^6.10.1",
    "@prisma/extension-optimize": "^2.0.0",
    "@types/helmet": "^4.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "helmet": "^8.1.0",
    "i18next": "^25.2.1",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-middleware": "^3.7.4",
    "morgan": "^1.10.0",
    "nestjs-i18n": "^10.5.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.0",
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@nestjs/testing": "^11.1.3",
    "@swc/cli": "^0.7.7",
    "@swc/core": "^1.12.7",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.7",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.35.0",
    "@typescript-eslint/parser": "^8.35.0",
    "eslint": "^9.30.0",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-nestjs": "^1.2.3",
    "eslint-plugin-perfectionist": "^4.15.0",
    "eslint-plugin-prettier": "^5.5.1",
    "eslint-plugin-spellcheck": "^0.0.20",
    "globals": "^16.2.0",
    "prettier": "^3.6.2",
    "prisma": "^6.10.1",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.0"
  },
  "prisma": {
    "schema": "database/prisma"
  }
}

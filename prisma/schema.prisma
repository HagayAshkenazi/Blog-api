generator client {
  provider = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["public", "blog"]
}

model PostData {
  id          String   @id @default(uuid()) @db.Uuid
  title       String   @db.VarChar(25)
  content     String
  publishTime DateTime @map("publish_time")

  @@map("posts")
  @@schema("blog")
}
generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Post {
  id        String   @id @default(uuid()) @db.Uuid
  title     String   @db.VarChar(25)
  content   String   @db.VarChar(200)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("posts")
}
